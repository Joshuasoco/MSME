# Botpress Configuration
# Get these from your Botpress Dashboard (https://app.botpress.cloud)
# Go to: Your Bot > Integrations > Webchat

# Your Bot ID (required)
VITE_BOTPRESS_BOT_ID=your_bot_id_here

# Your Client ID (required)
VITE_BOTPRESS_CLIENT_ID=your_client_id_here

# Custom Stylesheet ID (optional)
VITE_BOTPRESS_STYLE_ID=your_style_id_here

# Public website URL used for SEO canonical/OG metadata
VITE_SITE_URL=https://msmepathways.ph

# Optional customer support phone shown in footer/schema
# VITE_CONTACT_PHONE=+63 917 123 4567
